# Скопируй этот файл в .env.local и заполни значения.
# Оба значения берутся в панели Supabase: Project Settings -> API.

# URL проекта Supabase (поле "Project URL"), например https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=

# Публичный анонимный ключ (поле "Project API keys" -> "anon public").
# Это публичный ключ, он попадает в бандл — service_role сюда класть НЕЛЬЗЯ.
VITE_SUPABASE_ANON_KEY=
